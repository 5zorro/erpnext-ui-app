npm-debug.log*
yarn-error.log*
.DS_Store
*.swp
*~
# Hand-made backups. `*~` and `*.swp` covered the editor's own, but not the ones people make by
# renaming — electron/bill.html.old sat untracked-but-not-ignored because the rule below names
# electron/bill.html exactly and gitignore does no suffix matching.
*.old
*.bak
*.orig

# Local secrets / sandbox credentials — never commit
.env
.env.*
!.env.example

# Playwright / Electron artifacts
test-results/
playwright-report/
blob-report/
.playwright/

# Editor
.vscode/
.idea/
# Local Cursor rules/state — recreate via link script from Windows SSoT if needed.
# Do not commit Windows path symlinks (they break clones).
.cursor/
.cursorrules

# OS
Thumbs.db

# DevTools captures (may contain cookies)
*.har
localhost.har
.git-replace-5zorro.txt

# Python bytecode from ops seed helpers
**/__pycache__/
*.py[cod]

# Local print / PDF dogfood artifacts
*.pdf
output.pdf
ops/sample-data/dogfood-sources/generated/

# Local agent orientation — not part of the public tree (HANDOFF.md is the tracked SSoT).
CLAUDE.md

# Legacy Bill shell (tranche 10) — SSoT: electron/bill-shell.fragment.html + doc-form.html.
# Globbed so a renamed copy cannot slip back in; the real history is in git (see 8a10b6e).
electron/bill.html*
